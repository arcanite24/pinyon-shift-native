#version 450
// carview: the GPU-driven world's culling pass (world_gpu.cpp). One thread per
// draw of the resident table: frustum four side planes, prop LOD band, and
// reprojected previous-frame Hi-Z occlusion culling, then a
// VkDrawIndexedIndirectCommand appended to the draw's batch.
// counts[0..3] drawn, counts[4..7] tested, counts[8..11] Hi-Z occluded.
layout(local_size_x = 64) in;

struct DrawGpu {
  vec4 tint;
  vec4 params;  // x blend, y flags, z far level, w light gain
  uvec4 tex0;
  uvec4 tex1;
  vec4 box_min;
  vec4 box_max;
  uvec4 draw;   // index_count, first_index, vertex_offset (int bits), batch
  vec4 shift;
};
layout(std430, set = 0, binding = 0) readonly buffer Draws { DrawGpu items[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Commands { uint cmds[]; };
layout(std430, set = 0, binding = 2) buffer Counts { uint counts[12]; };
layout(set = 0, binding = 3) uniform sampler2D hiz_tex;
layout(set = 0, binding = 4) uniform CullUniforms {
  vec4 planes[4];   // normal.xyz, d: w+x, w-x, w+y, w-y in the scenery's frame
  vec4 eye_reach;   // xyz the eye in the scenery's frame, w the LOD reach (0: no LOD test)
  uvec4 info;       // x draws, y commands per batch, z frustum test on, w unused
  mat4 prev_vp;     // scenery space -> previous frame clip space
  uvec4 hiz_info;   // x hiz enabled, y reverse_z, z hiz_width, w hiz_height
} p;

const uint kFlagSky = 2u;
const uint kFlagLodNear = 128u;

bool hiz_occluded(vec3 bmin, vec3 bmax) {
  vec2 uv_min = vec2(1.0);
  vec2 uv_max = vec2(0.0);
  float z_near = (p.hiz_info.y != 0u) ? 0.0 : 1.0;
  for (int c = 0; c < 8; ++c) {
    const vec3 corner = vec3(
        (c & 1) != 0 ? bmax.x : bmin.x,
        (c & 2) != 0 ? bmax.y : bmin.y,
        (c & 4) != 0 ? bmax.z : bmin.z);
    const vec4 clip = p.prev_vp * vec4(corner, 1.0);
    if (clip.w <= 0.05) return false;
    const vec3 ndc = clip.xyz / clip.w;
    const vec2 uv = ndc.xy * 0.5 + 0.5;
    uv_min = min(uv_min, uv);
    uv_max = max(uv_max, uv);
    const float z = clamp(ndc.z, 0.0, 1.0);
    z_near = (p.hiz_info.y != 0u) ? max(z_near, z) : min(z_near, z);
  }
  if (uv_max.x <= 0.0 || uv_max.y <= 0.0 || uv_min.x >= 1.0 || uv_min.y >= 1.0) return false;
  uv_min = clamp(uv_min, vec2(0.0), vec2(1.0));
  uv_max = clamp(uv_max, vec2(0.0), vec2(1.0));
  const float pw = (uv_max.x - uv_min.x) * float(p.hiz_info.z);
  const float ph = (uv_max.y - uv_min.y) * float(p.hiz_info.w);
  const float span = max(pw, ph);
  const float lod = span > 1.0 ? ceil(log2(span)) : 0.0;
  const float d0 = textureLod(hiz_tex, vec2(uv_min.x, uv_min.y), lod).r;
  const float d1 = textureLod(hiz_tex, vec2(uv_max.x, uv_min.y), lod).r;
  const float d2 = textureLod(hiz_tex, vec2(uv_min.x, uv_max.y), lod).r;
  const float d3 = textureLod(hiz_tex, vec2(uv_max.x, uv_max.y), lod).r;
  if (p.hiz_info.y != 0u) {
    const float hiz_min = min(min(d0, d1), min(d2, d3));
    return z_near + 1e-4 < hiz_min;
  }
  const float hiz_max = max(max(d0, d1), max(d2, d3));
  return z_near - 1e-4 > hiz_max;
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= p.info.x) return;
  const DrawGpu d = items[i];
  if (d.draw.x == 0u) return;  // template-only row (e.g. hardware-instanced trees)
  const uint batch = min(d.draw.w, 3u);
  const uint flags = uint(d.params.y + 0.5);
  atomicAdd(counts[4 + batch], 1u);
  if (p.info.z != 0u) {
    for (int k = 0; k < 4; ++k) {
      const vec4 pl = p.planes[k];
      const vec3 c = vec3(pl.x >= 0.0 ? d.box_max.x : d.box_min.x, pl.y >= 0.0 ? d.box_max.y : d.box_min.y,
                          pl.z >= 0.0 ? d.box_max.z : d.box_min.z);
      if (dot(pl.xyz, c) + pl.w < 0.0) return;
    }
  }
  if (p.eye_reach.w > 0.0 && (flags & kFlagLodNear) != 0u) {
    const vec3 q = max(max(d.box_min.xyz - p.eye_reach.xyz, vec3(0.0)), p.eye_reach.xyz - d.box_max.xyz);
    if (dot(q, q) > p.eye_reach.w * p.eye_reach.w) return;
  }
  if (p.hiz_info.x != 0u && (flags & kFlagSky) == 0u && d.params.z < 0.5) {
    if (hiz_occluded(d.box_min.xyz, d.box_max.xyz)) {
      atomicAdd(counts[8 + batch], 1u);
      return;
    }
  }
  const uint slot = atomicAdd(counts[batch], 1u);
  if (slot >= p.info.y) return;
  const uint base = (batch * p.info.y + slot) * 5u;
  cmds[base + 0u] = d.draw.x;  // indexCount
  cmds[base + 1u] = 1u;        // instanceCount
  cmds[base + 2u] = d.draw.y;  // firstIndex
  cmds[base + 3u] = d.draw.z;  // vertexOffset (int bits)
  cmds[base + 4u] = i;         // firstInstance: the draw's row in the table
}
