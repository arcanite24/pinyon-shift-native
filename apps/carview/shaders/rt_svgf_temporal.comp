#version 460
#extension GL_GOOGLE_include_directive : require
// RT-3: Zero-Dependency Built-In SVGF Spatiotemporal Reprojection + Variance Estimation.
// Works identically for Hybrid RT Reflections (rt_mode == 1) and Full Path Tracing (rt_mode == 2).
#include "rt_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
  ivec2 px = ivec2(gl_GlobalInvocationID.xy);
  ivec2 sz = ivec2(int(ubo.rt_params.z), int(ubo.rt_params.w));
  if (px.x >= sz.x || px.y >= sz.y) return;

  int rt_mode = int(ubo.env_basis_y.w + 0.5);
  bool is_pt = (rt_mode == 2);

  vec4 curr_sample = is_pt ? imageLoad(rt_pt_img, px) : imageLoad(rt_refl_img, px);
  vec3 curr_col = curr_sample.rgb;
  float center_demod = 0.0;
  if (is_pt) {
    vec4 ga = imageLoad(rt_gbuf_albedo, px);
    center_demod = ga.w;
    if (ga.w > 0.5) curr_col /= max(ga.rgb, vec3(0.06));
  }
  float curr_l = luma(curr_col);

  vec2 uv = (vec2(px) + 0.5) / vec2(sz);
  // In Path Tracing mode, use TLAS primary hit distance (rt_pt_img.a) instead of raster
  // billboard depth_tex so tree cross-quads and raster billboards never disagree at silhouettes!
  float z = textureLod(depth_tex, uv, 0.0).r;
  float curr_d = is_pt ? curr_sample.a : linearize_depth(z);
  bool is_sky = is_pt ? (curr_d >= 1e4) : is_sky_depth_val(z);
  vec4 mv = textureLod(motion_tex, uv, 0.0);

  vec2 prev_uv = uv - mv.xy;
  bool valid = (ubo.eye_frame.w > 1.5) && !is_sky &&
               all(greaterThanEqual(prev_uv, vec2(0.001))) && all(lessThan(prev_uv, vec2(0.999))) &&
               (mv.b < 0.55);

  // 3x3 neighborhood mean & std-dev for anti-ghosting variance clamping (in demodulated irradiance space for PT).
  // Skip sky / mismatched-demod neighbors so bright sky behind tree edges never bleeds into pine silhouettes.
  vec3 m1_nb = curr_col;
  vec3 m2_nb = curr_col * curr_col;
  float w_nb = 1.0;
  for (int dy = -1; dy <= 1; ++dy) {
    for (int dx = -1; dx <= 1; ++dx) {
      if (dx == 0 && dy == 0) continue;
      ivec2 q = clamp(px + ivec2(dx, dy), ivec2(0), sz - ivec2(1));
      vec4 qs = is_pt ? imageLoad(rt_pt_img, q) : imageLoad(rt_refl_img, q);
      vec3 c = qs.rgb;
      if (is_pt) {
        if ((qs.a >= 1e4) != is_sky) continue;
        vec4 qga = imageLoad(rt_gbuf_albedo, q);
        if (abs(qga.w - center_demod) > 0.5) continue;
        if (qga.w > 0.5) c /= max(qga.rgb, vec3(0.06));
      }
      m1_nb += c;
      m2_nb += c * c;
      w_nb += 1.0;
    }
  }
  m1_nb /= w_nb;
  m2_nb /= w_nb;
  vec3 sigma_nb = sqrt(max(m2_nb - m1_nb * m1_nb, vec3(0.0)));

  vec3 accum_col = curr_col;
  float m1 = curr_l;
  float m2 = curr_l * curr_l;
  float hist_len = 1.0;

  if (valid) {
    ivec2 prev_px = clamp(ivec2(prev_uv * vec2(sz)), ivec2(0), sz - ivec2(1));
    vec4 prev_hist = imageLoad(rt_hist_prev, prev_px);
    vec4 prev_mom = imageLoad(rt_moments_prev, prev_px);
    float prev_d = prev_mom.w;

    // Depth consistency check (reject disoccluded background / moving car silhouettes).
    float rel_d = abs(curr_d - prev_d) / max(max(curr_d, prev_d), 0.25);
    if (rel_d < 0.08 && prev_mom.z >= 1.0) {
      hist_len = min(prev_mom.z + 1.0, 20.0);
      float alpha = max(1.0 / hist_len, is_pt ? 0.08 : 0.12);
      // Clamp history into neighborhood AABB to prevent smear behind fast traffic.
      vec3 box_min = max(m1_nb - sigma_nb * 2.25, vec3(0.0));
      vec3 box_max = m1_nb + sigma_nb * 2.25;
      vec3 clamped_prev = clamp(prev_hist.rgb, box_min, box_max);

      accum_col = mix(clamped_prev, curr_col, alpha);
      m1 = mix(prev_mom.x, curr_l, max(alpha, 0.15));
      m2 = mix(prev_mom.y, curr_l * curr_l, max(alpha, 0.15));
    }
  }

  float variance = max(m2 - m1 * m1, 0.0);
  if (hist_len < 4.0) {
    // Boost spatial variance estimate on freshly disoccluded pixels so A-Trous cleans them fast.
    variance = max(variance, dot(sigma_nb, vec3(0.333)) * 1.5);
  }

  imageStore(rt_hist_curr, px, vec4(accum_col, variance));
  imageStore(rt_moments_curr, px, vec4(m1, m2, hist_len, curr_d));
}
