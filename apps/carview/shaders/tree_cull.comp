#version 450
// carview: per-tree GPU frustum + Hi-Z culling pass into one hardware-instanced indirect draw.
layout(local_size_x = 64) in;

struct TreeInstanceGpu {
  vec4 base_hw;
  vec4 up_h;
  vec4 uv_rect;
  uvec4 col_tex;
};

layout(std430, set = 0, binding = 0) readonly buffer Trees { TreeInstanceGpu trees[]; };
layout(std430, set = 0, binding = 1) writeonly buffer VisibleTrees { uint visible_indices[]; };
layout(std430, set = 0, binding = 2) buffer IndirectCmd {
  uint vertex_count;
  uint instance_count;
  uint first_vertex;
  uint first_instance;
} cmd;
layout(set = 0, binding = 3) uniform sampler2D hiz_tex;
layout(set = 0, binding = 4) uniform CullUniforms {
  vec4 planes[4];
  vec4 eye_reach;
  uvec4 info;       // x tree_count, y max_trees, z frustum_on, w unused
  mat4 prev_vp;
  uvec4 hiz_info;   // x hiz_on, y reverse_z, z hiz_w, w hiz_h
} p;

const float kHizMaxTurnCos = 0.99026807;  // cos(8 deg): skip Hi-Z on fast hairpin turns / Look-Back / camera cuts

bool hiz_camera_stable() {
  if (p.hiz_info.x == 0u) return false;
  const vec3 curr_raw = p.planes[0].xyz + p.planes[1].xyz;
  const vec3 prev_raw = vec3(p.prev_vp[0][3], p.prev_vp[1][3], p.prev_vp[2][3]);
  const float curr_len2 = dot(curr_raw, curr_raw);
  const float prev_len2 = dot(prev_raw, prev_raw);
  if (curr_len2 < 1e-6 || prev_len2 < 1e-6) return false;
  const vec3 curr_fwd = curr_raw * inversesqrt(curr_len2);
  const vec3 prev_fwd = prev_raw * inversesqrt(prev_len2);
  if (dot(curr_fwd, prev_fwd) < kHizMaxTurnCos) return false;
  const vec4 prev_eye = p.prev_vp * vec4(p.eye_reach.xyz, 1.0);
  if (abs(prev_eye.w) > 12.0 || dot(prev_eye.xy, prev_eye.xy) > 144.0) return false;
  return true;
}

bool hiz_occluded(vec3 bmin, vec3 bmax) {
  vec2 uv_min = vec2(1.0);
  vec2 uv_max = vec2(0.0);
  float z_near = (p.hiz_info.y != 0u) ? 0.0 : 1.0;
  for (int c = 0; c < 8; ++c) {
    const vec3 corner = vec3(
        (c & 1) != 0 ? bmax.x : bmin.x,
        (c & 2) != 0 ? bmax.y : bmin.y,
        (c & 4) != 0 ? bmax.z : bmin.z);
    const vec4 clip = p.prev_vp * vec4(corner, 1.0);
    if (clip.w <= 0.05) return false;
    const vec3 ndc = clip.xyz / clip.w;
    const vec2 uv = ndc.xy * 0.5 + 0.5;
    uv_min = min(uv_min, uv);
    uv_max = max(uv_max, uv);
    const float z = clamp(ndc.z, 0.0, 1.0);
    z_near = (p.hiz_info.y != 0u) ? max(z_near, z) : min(z_near, z);
  }
  // Never Hi-Z cull trees that extended outside the previous viewport (prevents edge-of-screen pop-in on turns).
  if (uv_min.x <= 0.01 || uv_min.y <= 0.01 || uv_max.x >= 0.99 || uv_max.y >= 0.99) return false;
  const float span = max((uv_max.x - uv_min.x) * float(p.hiz_info.z), (uv_max.y - uv_min.y) * float(p.hiz_info.w));
  const float lod = span > 1.0 ? ceil(log2(span)) : 0.0;
  const float d0 = textureLod(hiz_tex, vec2(uv_min.x, uv_min.y), lod).r;
  const float d1 = textureLod(hiz_tex, vec2(uv_max.x, uv_min.y), lod).r;
  const float d2 = textureLod(hiz_tex, vec2(uv_min.x, uv_max.y), lod).r;
  const float d3 = textureLod(hiz_tex, vec2(uv_max.x, uv_max.y), lod).r;
  if (p.hiz_info.y != 0u) return z_near + 1e-4 < min(min(d0, d1), min(d2, d3));
  return z_near - 1e-4 > max(max(d0, d1), max(d2, d3));
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i >= p.info.x) return;
  const TreeInstanceGpu t = trees[i];
  const vec3 top = t.base_hw.xyz + t.up_h.xyz * t.up_h.w;
  const float r = t.base_hw.w;
  const vec3 bmin = min(t.base_hw.xyz, top) - vec3(r);
  const vec3 bmax = max(t.base_hw.xyz, top) + vec3(r);
  if (p.info.z != 0u) {
    for (int k = 0; k < 4; ++k) {
      const vec4 pl = p.planes[k];
      const vec3 c = vec3(pl.x >= 0.0 ? bmax.x : bmin.x, pl.y >= 0.0 ? bmax.y : bmin.y,
                          pl.z >= 0.0 ? bmax.z : bmin.z);
      if (dot(pl.xyz, c) + pl.w < 0.0) return;
    }
  }
  if (hiz_camera_stable() && hiz_occluded(bmin, bmax)) return;
  const uint slot = atomicAdd(cmd.instance_count, 1u);
  if (slot < p.info.y) visible_indices[slot] = i;
}
