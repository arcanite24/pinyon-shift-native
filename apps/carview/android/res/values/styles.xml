<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deep obsidian dark launch theme so cold start has zero white flash. -->
    <style name="ShiftLauncherTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E1015</item>
        <item name="android:colorBackground">#0E1015</item>
        <item name="android:statusBarColor">#0E1015</item>
        <item name="android:navigationBarColor">#0E1015</item>
        <item name="android:colorPrimary">#151821</item>
        <item name="android:colorPrimaryDark">#0E1015</item>
        <item name="android:colorAccent">#E8195E</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Fullscreen obsidian theme for SDL Vulkan gameplay activity. -->
    <style name="ShiftDriveTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#0E1015</item>
        <item name="android:colorBackground">#0E1015</item>
        <item name="android:statusBarColor">#0E1015</item>
        <item name="android:navigationBarColor">#0E1015</item>
        <item name="android:colorAccent">#E8195E</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
