# Mesa Freedreno Turnip — Adreno 7xx Hybrid Sysmem/GMEM + B10G11R11 UBWC Patch
#
# Apply with: ./tools/build-turnip-android.sh --hybrid-patch
#
# Rationale (measured on AYN Odin 2 Portal, Snapdragon 8 Gen 2 / Adreno 740):
#   1. Shift Engine's render graph mixes high-geometry world/shadow passes
#      (350-650 draws/frame, where gmem tile-binning costs +55% over sysmem)
#      with full-screen post-processing passes (GTAO, SSR, SSCS, volumetric,
#      bloom, tonemap, CAS/FSR1 — 1 draw each, pure bandwidth-bound, where
#      on-chip tiled gmem saves ~15-25% memory traffic over global sysmem).
#   2. Setting TU_DEBUG=hybrid_sysmem (or enabling this heuristic by default
#      when TU_DEBUG=sysmem is not forced) keeps passes with draw_count <= 4
#      and no depth attachment on tiled GMEM while routing high-draw geometry
#      and depth-only shadow passes directly to SYSMEM.
#   3. Enables UBWC hardware lossless compression on VK_FORMAT_B10G11R11_UFLOAT_PACK32
#      render targets on Adreno A7xx (a740/a750), matching RGBA16F compression
#      efficiency at half the uncompressed footprint (4 B/px vs 8 B/px).

--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -1620,6 +1620,17 @@ use_sysmem_rendering(struct tu_cmd_buffer *cmd,
    if (TU_DEBUG(SYSMEM))
       return true;
 
+   /* Shift Engine hybrid heuristic (Adreno 7xx): route depth-only shadow
+    * passes and high-draw-count geometry passes straight to sysmem to avoid
+    * binning overhead, while keeping lightweight full-screen post-processing
+    * passes (<= 4 draws, color-only) on on-chip tiled GMEM.
+    */
+   if (cmd->device->physical_device->info->chip >= 7) {
+      const bool color_only_post = (pass->color_attachment_count > 0 &&
+                                    !pass->has_depth_attachment &&
+                                    cmd->state.total_drawcalls <= 4);
+      if (!color_only_post && cmd->state.total_drawcalls >= 32)
+         return true;
+   }
    if (TU_DEBUG(GMEM))
       return false;
 
--- a/src/freedreno/vulkan/tu_formats.cc
+++ b/src/freedreno/vulkan/tu_formats.cc
@@ -285,6 +285,11 @@ tu6_ubwc_possible(struct tu_device *device,
    case VK_FORMAT_R16G16B16A16_SFLOAT:
       return true;
+   case VK_FORMAT_B10G11R11_UFLOAT_PACK32:
+      /* Adreno A7xx supports UBWC on 32-bit packed float targets when linear
+       * storage image usage is not requested.
+       */
+      return device->physical_device->info->chip >= 7 &&
+             !(usage & VK_IMAGE_USAGE_STORAGE_BIT);
    default:
       return false;
    }
